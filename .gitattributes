# Enforce LF line endings globally — prevents CRLF in shell scripts causing
# "bad interpreter: No such file or directory" under Git Bash / WSL2
* text=auto eol=lf

# Explicitly enforce LF for shell scripts
*.sh text eol=lf

# Helm templates and YAML always LF
*.yaml text eol=lf
*.yml text eol=lf

# Python sources always LF
*.py text eol=lf

# Binary files — no line-ending conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.tar binary
*.zip binary
