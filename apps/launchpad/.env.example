# Copy this file to .env and fill in real values for local development.
# The .env file is listed in .gitignore — NEVER commit real credentials.

# MongoDB connection URI for launchpad's OWN MongoDB. For local dev, point at
# a local MongoDB instance. In-cluster, this is supplied via a Kubernetes
# Secret — NEVER a real credential in this file.
MONGO_URI=mongodb://localhost:27017/launchpad

# In-cluster DNS name for field-guide-api's ClusterIP Service. Override for
# local dev if port-forwarding field-guide-api (e.g. http://localhost:8080).
FIELD_GUIDE_BASE_URL=http://field-guide-api

# Displayed in /api/status. Overridden by the Helm chart / CI in a real build.
APP_VERSION=dev

# Set to "1", "true", "yes", or "on" ONLY during local debugging.
# Any other value (including "0", "false", empty, or unset) disables debug.
# MUST be empty (or unset/0) in containers and Kubernetes deployments.
FLASK_DEBUG=
